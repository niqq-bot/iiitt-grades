meta {
  name: AddDepartment
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/hod/departments/addDepartment
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "code": "CSE",
    "name": "computer science and engineering"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
