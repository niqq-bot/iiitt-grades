meta {
  name: addAcademicSession
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/hod/academic/addAcademicSession
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "academicYear": "2026-27",
    "semester": 1,
    "regulationVersion": "R2024",
    "gradingPolicyVersion": "GP1"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
